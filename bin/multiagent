#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ -n "${MULTIAGENT_BIN:-}" ]]; then
  exec "$MULTIAGENT_BIN" "$@"
fi

command -v cargo >/dev/null 2>&1 || {
  echo "multiagent: Rust binary is not built and cargo is unavailable" >&2
  exit 1
}

exec cargo run --quiet --manifest-path "$PROJECT_ROOT/Cargo.toml" -- "$@"
