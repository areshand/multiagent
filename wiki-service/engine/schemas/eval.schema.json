  "properties": {
    "feedback_id": {"type": "string"},
    "test_query": {"type": "string"},
    "required_pages": {"type": "array", "items": {"type": "string"}},
    "expected_behavior": {"type": "string"},
    "failure_mode": {"type": "string"},
    "pass_criteria": {"type": "string"}
  }
}
